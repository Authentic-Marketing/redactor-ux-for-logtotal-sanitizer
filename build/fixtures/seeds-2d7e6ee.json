{
 "commit": "2d7e6ee",
 "note": "SEEDED_RULES as shipped at 2d7e6ee, the build before the 2026-09-23 expansion",
 "rules": [
  {
   "id": "agent_apis",
   "label": "LLM APIs",
   "description": "Keys and endpoints for the model vendors: OpenAI, Anthropic, Google, Grok, Perplexity, Azure OpenAI and GitHub Copilot.",
   "mode": "mask",
   "token": "LLMAPI",
   "patterns": [
    "\\bsk-ant-(?:api|admin)\\d{2}-[A-Za-z0-9_-]{80,140}\\b",
    "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,120}T3BlbkFJ[A-Za-z0-9_-]{20,120}\\b",
    "\\bsk-[A-Za-z0-9]{48}\\b",
    "\\bAIza[0-9A-Za-z_-]{35}\\b",
    "\\bAQ\\.[A-Za-z0-9_-]{20,}",
    "\\bxai-[A-Za-z0-9]{80}\\b",
    "\\bpplx-[A-Za-z0-9]{48,56}\\b",
    "\\bgh[osu]_[0-9a-zA-Z]{36}\\b",
    "\\bgithub_pat_[0-9a-zA-Z_]{82}\\b",
    "[Aa][Pp][Ii]-[Kk][Ee][Yy]\\s*[:=]\\s*\"?([0-9a-fA-F]{32})\\b",
    "\\bapi\\.anthropic\\.com\\b",
    "\\bapi\\.openai\\.com\\b",
    "\\bgenerativelanguage\\.googleapis\\.com\\b"
   ]
  },
  {
   "id": "crypto_addresses",
   "label": "Cryptocurrency addresses",
   "description": "Bitcoin, Ethereum, Tron, XRP, Solana, Dogecoin, Cardano, Litecoin, TON and Monero, and the tokens issued on them.",
   "mode": "pseudo",
   "token": "CRYPTO",
   "patterns": [
    "\\b(?:bc|tb)1[qp][a-z0-9]{38,58}\\b",
    "\\b[13](?=[a-km-zA-HJ-NP-Z1-9]*[1-9])[a-km-zA-HJ-NP-Z1-9]{25,34}\\b",
    "\\b0x[0-9a-fA-F]{40}\\b",
    "\\bT(?=[a-km-zA-HJ-NP-Z1-9]*[1-9])[a-km-zA-HJ-NP-Z1-9]{33}\\b",
    "\\br(?=[a-km-zA-HJ-NP-Z1-9]*[1-9])[a-km-zA-HJ-NP-Z1-9]{24,34}\\b",
    "\\bX(?=[a-km-zA-HJ-NP-Z1-9]*[1-9])[a-km-zA-HJ-NP-Z1-9]{46}\\b",
    "\\b(?=[a-km-zA-HJ-NP-Z1-9]*[1-9])(?=[a-km-zA-HJ-NP-Z1-9]*[a-z])(?=[a-km-zA-HJ-NP-Z1-9]*[A-Z])[a-km-zA-HJ-NP-Z1-9]{43,44}\\b",
    "\\bD[5-9A-HJ-NP-U][a-km-zA-HJ-NP-Z1-9]{32}\\b",
    "\\baddr(?:_test)?1[a-z0-9]{53,98}\\b",
    "\\bstake(?:_test)?1[a-z0-9]{53}\\b",
    "\\b(?:Ae2|DdzFF)[a-km-zA-HJ-NP-Z1-9]{50,110}\\b",
    "\\bltc1[a-z0-9]{38,58}\\b",
    "\\b[LM](?=[a-km-zA-HJ-NP-Z1-9]*[1-9])[a-km-zA-HJ-NP-Z1-9]{26,33}\\b",
    "\\b(?:EQ|UQ|kQ|0Q)[A-Za-z0-9_-]{46}\\b",
    "\\b[48][a-km-zA-HJ-NP-Z1-9]{94}\\b",
    "\\b4[a-km-zA-HJ-NP-Z1-9]{105}\\b"
   ],
   "jsonKeyContains": [
    "btc_addr",
    "bitcoin_addr",
    "btcaddress",
    "bitcoinaddress",
    "eth_addr",
    "evm_addr",
    "ethaddress",
    "erc20",
    "bep20",
    "contract_addr",
    "tron_addr",
    "trx_addr",
    "trc20",
    "xrp_addr",
    "ripple_addr",
    "xrpaddress",
    "sol_addr",
    "solana_addr",
    "spl_addr",
    "doge_addr",
    "dogecoin_addr",
    "ada_addr",
    "cardano_addr",
    "ltc_addr",
    "litecoin_addr",
    "ton_addr",
    "ton_wallet",
    "xmr_addr",
    "monero_addr"
   ]
  }
 ]
}